# SmartRSS Infrastructure Configuration (Production Defaults)
# Copy to .env and set a strong POSTGRES_PASSWORD before starting.

# Database
POSTGRES_USER=smartrss
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=smartrss
DATABASE_URL=postgresql+psycopg://smartrss:change-me-to-a-strong-password@db:5432/smartrss

# LAN Entry Point & Security
LAN_PORT=8080
# Comma-separated strict Host allow-list (add your LAN hostname/IP, e.g. smartrss.lan:8080,192.168.1.50:8080)
ALLOWED_HOSTS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080
# Comma-separated strict CORS allow-list (never use *)
CORS_ALLOW_ORIGINS=http://localhost:8080
# Additional CIDRs blocked by SafeHttpClient (all RFC1918 including default 172.16.0.0/12
# Docker bridges, loopback, link-local, CGNAT, ULA, and NAT64/6to4 private ranges are always
# blocked; add custom non-RFC1918 Docker bridges, your home WAN IPv4/32, or global IPv6 prefix here)
SSRF_BLOCKED_CIDRS=

# Worker Mode & Concurrency
# Set WORKER_MODE=cron and COMPOSE_PROFILES= to drive polling via external host cron (`smartrss worker run-once`)
WORKER_MODE=daemon
COMPOSE_PROFILES=daemon
WORKER_IO_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=30

# Initial DB Seed Defaults (used ONLY during initial migration 0001; DB app_settings is authoritative thereafter)
DEFAULT_POLL_INTERVAL_MINUTES=60
DEFAULT_BACKFILL_CAP=10
DEFAULT_EXPIRATION_DAYS=30

# Backups
BACKUP_DIR=./backups
# Optional off-host LAN copy (e.g. user@nas.lan:/srv/backups/smartrss)
BACKUP_RSYNC_TARGET=
BACKUP_REMOTE_RETENTION_DAYS=30
